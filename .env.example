# Copy this file to .env and fill in your values. Never commit .env.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
LLM_STRUCTURED_METHODS=response_format,tool_call

# Optional local fallback (slow without a GPU). Enabled only with: start-backend.cmd local
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=qwen3:4b
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Optional: send traces to Langfuse (https://langfuse.com). Leave empty to keep traces in backend/logs only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# DVMCP lab
DVMCP_HOST=localhost
DVMCP_PORT_RANGE=9001-9010
