# One origin for the page, the API and the WebSocket, so the browser needs no CORS and the backend's Origin check passes.
#
# GUARDIAN_SITE_ADDRESS decides how the site is served (default ":80"):
#   :80              plain HTTP on any address, including the server's Elastic IP. No domain, no certificates, no redirect.
#   a.domain.example HTTPS: Caddy gets and renews a certificate for that name, which then must point at this server.
# Nothing here assumes a domain: the first deployment is HTTP on the IP address.
{$GUARDIAN_SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /health /servers /servers/* /probe /ws/* /oauth/*
	handle @api {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
