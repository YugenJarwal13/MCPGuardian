# Copy to deploy/production.env on the server and fill in. Never commit production.env.
# The first deployment needs only the three secrets below: the site is served over plain HTTP on the server's Elastic IP.

# the AI inspectors (OpenRouter)
OPENROUTER_API_KEY=
# optional: a second OpenRouter account. Its key is used only after the first key fails (rejected, or its daily free quota is used up)
OPENROUTER_API_KEY_2=

# traces, cost and scores (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
GUARDIAN_ENVIRONMENT=production
GUARDIAN_VERSION=aws

# public-site limits: model-backed runs per day for the whole site, runs per visitor per hour
GUARDIAN_LLM_RUNS_PER_DAY=80
GUARDIAN_RUNS_PER_HOUR=12

# optional: require a key for every run
# GUARDIAN_ACCESS_KEY=

# --- optional, only when you later have a domain that points at this server (see docs/deployment.md, "HTTPS later") ---
# The address Caddy serves. Default ":80" = HTTP on any address. A domain name switches on automatic HTTPS.
# GUARDIAN_SITE_ADDRESS=
# The site's public address, used for OAuth sign-in callbacks of remote MCP servers. Empty = the address of the page.
# GUARDIAN_PUBLIC_URL=
