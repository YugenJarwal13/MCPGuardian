# HTTPS for the app. Caddy gets a Let's Encrypt certificate for the domain by itself (ports 80 and 443 must be
# reachable and the domain's A record must point at this server). WebSockets (/ws/run) are proxied as they are.
{$GUARDIAN_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:7860 {
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# www goes to the main address
www.{$GUARDIAN_DOMAIN} {
	redir https://{$GUARDIAN_DOMAIN}{uri} permanent
}
