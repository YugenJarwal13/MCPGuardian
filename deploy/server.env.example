# Copy to deploy/server.env on the server and fill in. This file is read by docker compose; never commit server.env.

GUARDIAN_DOMAIN=careeristpro.cloud

# the AI inspectors (OpenRouter)
OPENROUTER_API_KEY=

# traces, cost and scores (Langfuse); leave empty to run without
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# public-site limits: model-backed runs per day for the whole site, runs per visitor per hour
GUARDIAN_LLM_RUNS_PER_DAY=25
GUARDIAN_RUNS_PER_HOUR=12

# optional: require a key for every run
# GUARDIAN_ACCESS_KEY=
